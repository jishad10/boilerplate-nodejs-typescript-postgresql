{
  "compilerOptions": {
    "module":                       "commonjs",
    "target":                       "esnext",
    "rootDirs":                     ["./src", "."],
    "outDir":                       "./dist",
    "types":                        ["node"],
    "sourceMap":                    true,
    "declaration":                  true,
    "declarationMap":               true,
    "noUncheckedIndexedAccess":     true,
    "exactOptionalPropertyTypes":   true,
    "strict":                       true,
    "skipLibCheck":                 true,
    "esModuleInterop":              true,
    "allowSyntheticDefaultImports": true
  },
  "include":  ["src", "prisma.config.ts"],
  "exclude":  ["node_modules", "dist"]
}